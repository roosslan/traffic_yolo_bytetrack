# Скопируйте в .env и задайте свой пароль. Файл .env в git не добавляйте.
CLICKHOUSE_PASSWORD=
# Этой же переменной traffic_yolo_bytetrack берёт пароль для подключения (главнее config.toml):
TRAFFIC_CLICKHOUSE_PASSWORD=
# На каком адресе открыть порты ClickHouse: 0.0.0.0 - во всей сети, 127.0.0.1 - только здесь.
CLICKHOUSE_BIND=0.0.0.0
